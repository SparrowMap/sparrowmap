# The public-traffic-camera poller. Runs on its OWN box, not the hub.
#
# Install:
#   sudo cp deploy/sparrowmap-cams.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart sparrowmap-cams
#
# 🚨 THIS IS A CLIENT, NOT A SERVER. It listens on nothing. It fetches public
# JPEGs, finds vehicles, shrinks each catch below plate legibility, and POSTs
# the crop to the hub exactly like a volunteer's phone does. Nothing here needs
# an inbound port, so nothing here should ever open one.

[Unit]
Description=SparrowMap public traffic camera poller
After=network-online.target
Wants=network-online.target

# ⚠️ THESE TWO LIVE IN [Unit], NOT [Service], and systemd does not stop you
# putting them in the wrong one - it logs "Unknown key name" and carries on
# with no rate limit at all. A restart loop against somebody else's public
# camera network is how we get blocked, so the guard failing open is worse than
# it looks. If it has failed five times in ten minutes it is broken, and the
# right outcome is a stopped unit somebody has to look at.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=sparrow
Group=sparrow
WorkingDirectory=/opt/sparrowmap

# 🚨 WITHOUT THIS THE JOURNAL STAYS EMPTY UNTIL THE BUFFER FILLS.
# Python block-buffers stdout into a systemd pipe, so a poller that prints one
# line per sighting looks completely dead for hours. The hub learned this the
# expensive way; the same trap, same fix.
Environment=PYTHONUNBUFFERED=1

# 🚨 TWO POLLERS RUN THIS UNIT AND THEY MUST NOT POLL THE SAME LIST.
#
# Several US agencies refuse the Helsinki box outright - Kentucky answers it
# with a self-signed WatchGuard FIREWALL certificate, Indiana's image host
# times out, Michigan's index 403s - while serving a US address normally. So
# there is a second, smaller box in Ashburn whose whole job is the sources the
# European one cannot reach.
#
# The difference is CONFIGURATION, not a second copy of this file. A forked
# unit is how two machines quietly drift apart, and the failure mode is a
# source that both poll (double the load on somebody's public camera) or that
# neither does (a state silently missing from the map).
#
#   /etc/sparrowmap-cams.env      RAVEN_SOURCES=... RAVEN_INTERVAL=... RAVEN_WORKERS=...
#
# The defaults below are the Helsinki box's, so an env file is optional.
EnvironmentFile=-/etc/sparrowmap-cams.env

# --interval 300: a traffic camera refreshes every 1-5 minutes, so polling
#   faster only spends bandwidth re-downloading frames we already scored. It is
#   also what keeps a 4,400-camera fleet inside the box's 20 TB allowance.
#   ⚠️ THE ASHBURN BOX HAS 2 TB, NOT 20 - US allowances are an order of
#   magnitude smaller, so its interval is a bandwidth decision not a taste one.
# --workers 96: the fetch is 0.36s of WAITING per camera, almost none of it
#   CPU, so concurrency is what sizes the sweep - roughly 17s of fetching for
#   4,400 cameras. ⚠️ MEASURE the "cycle done in Ns" line before changing
#   either number; the run prints the arithmetic on startup for exactly this.
# --sources: nyc is deliberately absent. Its index times out from a datacentre
#   and 87% of its cameras are 352x240, below the 120px bar anyway.
ExecStart=/bin/sh -c '/opt/sparrowmap/.venv/bin/python /opt/sparrowmap/tools/public_cams.py \
    run --tokens /opt/sparrowmap/data/cam_tokens.json \
        --sources "$${RAVEN_SOURCES:-$${SPARROW_SOURCES:-fi,ia,atx,on,oh,ny,nm,mo,sea,wsd,tor,nl}}" \
        --interval "$${RAVEN_INTERVAL:-$${SPARROW_INTERVAL:-300}}" \
        --workers "$${RAVEN_WORKERS:-$${SPARROW_WORKERS:-96}}"'

Restart=on-failure
RestartSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The checkout is read-only to the service, which also means nothing at runtime
# can paper over a bad `git pull`. ⚠️ ProtectHome hides ~/.sparrowmap, the
# detector's DOWNLOAD cache - that is deliberate and safe only because the
# weights ship in the checkout (public/vendor/yolo11s.onnx) and load_model()
# prefers them. If that file ever stops being committed, this unit fails.
ReadWritePaths=/opt/sparrowmap/data

[Install]
WantedBy=multi-user.target
